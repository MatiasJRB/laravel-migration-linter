#!/usr/bin/env php
<?php

declare(strict_types=1);

use MatiasJRB\LaravelMigrationLinter\MigrationLinterApplication;

$autoloadCandidates = [
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
];

$autoload = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Unable to locate Composer autoload.php. Run composer install first.\n");
    exit(2);
}

require $autoload;

exit((new MigrationLinterApplication())->run());
